{
  "name": "toannv-ckeditor5-link",
  "version": "48.5.0",
  "description": "Link feature for CKEditor 5.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "CKSource (http://cksource.com/)",
  "homepage": "https://ckeditor.com/ckeditor-5",
  "bugs": "https://github.com/ckeditor/ckeditor5/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckeditor/ckeditor5.git",
    "directory": "packages/ckeditor5-link"
  },
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./src/*",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "toannv-ckeditor5-clipboard": "workspace:*",
    "toannv-ckeditor5-core": "workspace:*",
    "toannv-ckeditor5-engine": "workspace:*",
    "toannv-ckeditor5-enter": "workspace:*",
    "toannv-ckeditor5-icons": "workspace:*",
    "toannv-ckeditor5-image": "workspace:*",
    "toannv-ckeditor5-typing": "workspace:*",
    "toannv-ckeditor5-ui": "workspace:*",
    "toannv-ckeditor5-utils": "workspace:*",
    "toannv-ckeditor5-widget": "workspace:*",
    "es-toolkit": "1.45.1"
  },
  "devDependencies": {
    "toannv-ckeditor5-basic-styles": "workspace:*",
    "toannv-ckeditor5-block-quote": "workspace:*",
    "toannv-ckeditor5-cloud-services": "workspace:*",
    "toannv-ckeditor5-code-block": "workspace:*",
    "toannv-ckeditor5-easy-image": "workspace:*",
    "toannv-ckeditor5-editor-classic": "workspace:*",
    "toannv-ckeditor5-essentials": "workspace:*",
    "toannv-ckeditor5-paragraph": "workspace:*",
    "toannv-ckeditor5-table": "workspace:*",
    "toannv-ckeditor5-undo": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/nim/build-package.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless=false",
    "test:debug": "vitest --browser.headless=false",
    "coverage": "pnpm run test --coverage"
  },
  "files": [
    "dist",
    "ckeditor5-metadata.json",
    "CHANGELOG.md"
  ]
}
