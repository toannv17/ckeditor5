{
  "name": "toannv-ckeditor5-html-support",
  "version": "48.5.0",
  "description": "HTML Support feature for CKEditor 5.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "CKSource (http://cksource.com/)",
  "homepage": "https://ckeditor.com/ckeditor-5",
  "bugs": "https://github.com/ckeditor/ckeditor5/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckeditor/ckeditor5.git",
    "directory": "packages/ckeditor5-html-support"
  },
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin",
    "compatibility",
    "content compatibility",
    "html support",
    "generic html support"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./src/*",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "toannv-ckeditor5-clipboard": "workspace:*",
    "toannv-ckeditor5-core": "workspace:*",
    "toannv-ckeditor5-engine": "workspace:*",
    "toannv-ckeditor5-enter": "workspace:*",
    "toannv-ckeditor5-heading": "workspace:*",
    "toannv-ckeditor5-image": "workspace:*",
    "toannv-ckeditor5-list": "workspace:*",
    "toannv-ckeditor5-remove-format": "workspace:*",
    "toannv-ckeditor5-table": "workspace:*",
    "toannv-ckeditor5-utils": "workspace:*",
    "toannv-ckeditor5-widget": "workspace:*",
    "es-toolkit": "1.45.1"
  },
  "devDependencies": {
    "toannv-ckeditor5-alignment": "workspace:*",
    "toannv-ckeditor5-basic-styles": "workspace:*",
    "toannv-ckeditor5-block-quote": "workspace:*",
    "toannv-ckeditor5-cloud-services": "workspace:*",
    "toannv-ckeditor5-code-block": "workspace:*",
    "toannv-ckeditor5-easy-image": "workspace:*",
    "toannv-ckeditor5-editor-classic": "workspace:*",
    "toannv-ckeditor5-editor-multi-root": "workspace:*",
    "toannv-ckeditor5-essentials": "workspace:*",
    "toannv-ckeditor5-font": "workspace:*",
    "toannv-ckeditor5-highlight": "workspace:*",
    "toannv-ckeditor5-horizontal-line": "workspace:*",
    "toannv-ckeditor5-html-embed": "workspace:*",
    "toannv-ckeditor5-indent": "workspace:*",
    "toannv-ckeditor5-link": "workspace:*",
    "toannv-ckeditor5-media-embed": "workspace:*",
    "toannv-ckeditor5-page-break": "workspace:*",
    "toannv-ckeditor5-paragraph": "workspace:*",
    "toannv-ckeditor5-paste-from-office": "workspace:*",
    "toannv-ckeditor5-select-all": "workspace:*",
    "toannv-ckeditor5-source-editing": "workspace:*",
    "toannv-ckeditor5-style": "workspace:*",
    "toannv-ckeditor5-typing": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/nim/build-package.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless=false",
    "test:debug": "vitest --browser.headless=false",
    "coverage": "pnpm run test --coverage"
  },
  "files": [
    "dist",
    "ckeditor5-metadata.json",
    "CHANGELOG.md"
  ]
}
