{
  "name": "toannv-ckeditor5-core",
  "version": "48.5.0",
  "description": "The core architecture of CKEditor 5 – the best browser-based rich text editor.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "CKSource (http://cksource.com/)",
  "homepage": "https://ckeditor.com/ckeditor-5",
  "bugs": "https://github.com/ckeditor/ckeditor5/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckeditor/ckeditor5.git",
    "directory": "packages/ckeditor5-core"
  },
  "keywords": [
    "wysiwyg",
    "rich text",
    "editor",
    "html",
    "contentEditable",
    "editing",
    "operational transformation",
    "ot",
    "collaboration",
    "collaborative",
    "real-time",
    "framework",
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-lib"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./src/*",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "toannv-ckeditor5-engine": "workspace:*",
    "toannv-ckeditor5-ui": "workspace:*",
    "toannv-ckeditor5-utils": "workspace:*",
    "toannv-ckeditor5-watchdog": "workspace:*",
    "es-toolkit": "1.45.1"
  },
  "devDependencies": {
    "toannv-ckeditor5-autoformat": "workspace:*",
    "toannv-ckeditor5-basic-styles": "workspace:*",
    "toannv-ckeditor5-block-quote": "workspace:*",
    "toannv-ckeditor5-editor-classic": "workspace:*",
    "toannv-ckeditor5-essentials": "workspace:*",
    "toannv-ckeditor5-heading": "workspace:*",
    "toannv-ckeditor5-image": "workspace:*",
    "toannv-ckeditor5-indent": "workspace:*",
    "toannv-ckeditor5-link": "workspace:*",
    "toannv-ckeditor5-list": "workspace:*",
    "toannv-ckeditor5-media-embed": "workspace:*",
    "toannv-ckeditor5-paragraph": "workspace:*",
    "toannv-ckeditor5-table": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/nim/build-package.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless=false",
    "test:debug": "vitest --browser.headless=false",
    "coverage": "pnpm run test --coverage"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
